# ===========================================
# Onion Quality AI — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# --- Application ---
APP_NAME=onion-quality-backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/onion_quality

# --- Directories ---
MODEL_DIRECTORY=./models
IMAGE_DIRECTORY=./data/raw
REPORT_DIRECTORY=./reports

# --- Upload Limits ---
MAX_IMAGE_SIZE_MB=10
